# Set ENVIRONMENT to 'dev' (local) or 'prod' (production)
ENVIRONMENT=dev

# Application admin password: set on provisioning, never commit
PORT=4000
NODE_ENV=development

# Secrets: generate with e.g. `openssl rand -base64 32`
SESSION_SECRET=your_session_secret_here
JWT_SECRET=your_jwt_secret_here

# Database (app connection)
DB_NAME=neutra_db
DB_HOST=localhost
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password
# Required by Prisma CLI (migrate/generate). Composed from DB_* above.
DATABASE_URL=postgresql://your_db_user:your_db_password@localhost:5432/neutra_db?schema=public

# Docker compose (db service) — no defaults on purpose
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=neutra_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# CORS: comma-separated exact origins (production). localhost/LAN added in dev.
ALLOWED_ORIGINS=

# OAuth providers
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
TWITTER_CONSUMER_ID=
TWITTER_CONSUMER_SECRET=
CALLBACK_URL=
CALLBACK_URL_DEVELOPMENT=

# Email / SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
AWS_SES_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Frontend
FRONTEND_URL=http://localhost:3000

# Logging
LOG_LEVEL=info
LOG_PAYLOADS=false
LOG_RESPONSES=false
LOG_HEADERS=false

# WhatsApp Cloud API
WHATSAPP_API_VERSION=
WHATSAPP_API_BASE_URL=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ENCRYPTION_KEY=
