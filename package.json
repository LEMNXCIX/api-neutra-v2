    "dotenv": "^18.0.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "express-session": "^1.18.2",
    "handlebars": "^4.7.10",
    "helmet": "^8.3.0",
    "ics": "^3.8.1",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "lusca": "^1.7.0",
    "morgan": "^1.10.1",
