{
  "name": "ecommerce",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "pretest": "tsx ./scripts/clean-dist.ts",
    "test": "cross-env NODE_ENV=test jest --runInBand --forceExit",
    "test:unit": "cross-env NODE_ENV=test jest --config jest.unit.config.cjs --runInBand",
    "test:ci": "cross-env NODE_ENV=test jest --runInBand --forceExit",
    "build": "tsc -p tsconfig.build.json && tsx ./scripts/verify-production-build.ts --rewrite",
    "verify:production": "tsx ./scripts/verify-production-build.ts",
    "doctor": "tsx ./scripts/api-doctor/cli.ts",
    "start": "tsx ./app.ts",
    "dev": "cross-env NODE_ENV=development tsx ./app.ts",
    "dev:watch": "cross-env NODE_ENV=development nodemon --watch \"./**/*.ts\" --exec \"tsx ./app.ts\"",
    "postinstall": "prisma generate",
    "check:arch": "node scripts/check-architecture.ts",
    "lint:arch": "node scripts/check-architecture.ts",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "check": "biome ci"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
